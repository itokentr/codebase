{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@repo/configs/typescript/react",
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "oxlint.config.ts"]
}

{
  "name": "@lib/scaffold",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./oxlint/*": {
      "types": "./src/packages/oxlint/*.ts",
      "default": "./src/packages/oxlint/*.ts"
    },
    "./tsconfig": {
      "default": "./src/packages/typescript/tsconfig-base.json"
    },
    "./tsconfig/*": {
      "default": "./src/packages/typescript/tsconfig-*.json"
    }
  },
  "scripts": {
    "build-bin": "bun bin/build.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint --type-aware -f unix"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@inquirer/prompts": "^8.6.0",
    "@lib/fs": "workspace:^",
    "@lib/path": "workspace:^",
    "@npmcli/package-json": "^8.0.0",
    "@repo/test": "workspace:^",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/svelte": "catalog:",
    "@tsconfig/vite-react": "catalog:",
    "@types/node": "catalog:",
    "@types/npmcli__package-json": "^4.0.4",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "esbuild": "catalog:",
    "eslint": "^10.9.0",
    "execa": "^10.0.1",
    "find-up": "^8.0.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
